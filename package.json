{
  "name": "shrine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3003",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts --no-match-contract LiveOracleFork -vv",
    "contracts:test:fork": "forge test --root contracts --match-contract LiveOracleFork --fork-url https://rpc1mainnet.qie.digital -vv",
    "contracts:deploy": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts --rpc-url qie --broadcast",
    "contracts:deploy:testnet": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts --rpc-url qie_testnet --broadcast"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.5",
    "@walletconnect/ethereum-provider": "^2.21.5",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.31.0",
    "next": "^15.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.31.7",
    "wagmi": "^2.16.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.10",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
